# Inherit the repository-level environment (DEVELOCITY_*, .env.local, ...).
source_up_if_exists

# Develocity npm agent — standard, Gradle-independent integration.
#
# The agent instruments the `npm` process itself (not child scripts), so the
# preload MUST be set in the environment via NODE_OPTIONS — an `.npmrc`
# `node-options` entry only reaches child scripts (e.g. `ng`) and is NOT enough.
#
# With this in place, every `npm run <script>` executed from this directory
# publishes a Build Scan (server configured in develocity.config.cjs). The agent
# no-ops for non-npm node processes, so it is safe for all tooling run here.
#
# Scoped to frontend-angular on purpose: the preload module is resolved from the
# local node_modules, so it must only be active where the agent is installed.
export NODE_OPTIONS="-r @gradle-tech/develocity-agent/preload"
