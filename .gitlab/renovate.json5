{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
  ],
  rebaseWhen: 'never',
  assignees: [
    '@davinkevin',
  ],
  ignorePaths: [
    // In frontend modules, only build.gradle.kts and docker/Dockerfile are tracked
    // by Renovate. JavaScript dependencies (package.json, yarn.lock) are managed manually.
    'frontend-angular/package.json',
    'frontend-angular/yarn.lock',
    'frontend-angularjs/package.json',
  ],
  kubernetes: {
    fileMatch: [
      'distribution/kubernetes/.+\\.yaml$',
    ],
  },
  packageRules: [
    {
      matchPackageNames: [
        'software.amazon.awssdk:bom',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      versioning: 'regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z$',
      automerge: true,
      matchPackageNames: [
        '/^minio/',
      ],
    },
    {
      groupName: 'all-flyway',
      groupSlug: 'all-flyway',
      matchPackageNames: [
        '/.*flyway.*/',
      ],
    },
    {
      groupName: 'all-kotlin',
      groupSlug: 'all-kotlin',
      matchPackageNames: [
        '/^org.jetbrains.kotlin.*/',
      ],
    },
  ],
}
