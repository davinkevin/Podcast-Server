{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
  ],
  rebaseWhen: 'never',
  assignees: [
    '@davinkevin',
  ],
  ignorePaths: [
    // frontend-angularjs is legacy: only build.gradle.kts and docker/Dockerfile are
    // tracked by Renovate, its JavaScript dependencies are managed manually.
    'frontend-angularjs/package.json',
  ],
  kubernetes: {
    fileMatch: [
      'distribution/kubernetes/.+\\.yaml$',
    ],
  },
  packageRules: [
    {
      matchPackageNames: [
        'software.amazon.awssdk:bom',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      versioning: 'regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z$',
      automerge: true,
      matchPackageNames: [
        '/^minio/',
      ],
    },
    {
      groupName: 'all-flyway',
      groupSlug: 'all-flyway',
      matchPackageNames: [
        '/.*flyway.*/',
      ],
    },
    {
      groupName: 'all-kotlin',
      groupSlug: 'all-kotlin',
      matchPackageNames: [
        '/^org.jetbrains.kotlin.*/',
      ],
    },
    {
      // Keep the Angular ecosystem in lockstep: framework, CLI, build, ESLint
      // integration and the Analog test tooling all move together.
      groupName: 'all-angular',
      groupSlug: 'all-angular',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        '/^@angular\\//',
        '/^@angular-eslint\\//',
        'angular-eslint',
        '/^@analogjs\\//',
      ],
    },
    {
      // TypeScript and zone.js are version-locked by Angular's peer dependency
      // ranges. Renovate has no peer-dependency solver, so keep it inside the
      // existing tilde ranges (patch-level only). Crossing to a new minor happens
      // manually via `ng update` when moving Angular major.
      rangeStrategy: 'in-range-only',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        'typescript',
        'zone.js',
      ],
    },
  ],
}
