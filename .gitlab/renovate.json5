{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
  ],
  // Let Renovate rebase and regenerate lock files itself when a branch becomes
  // conflicted (e.g. a lock file conflict after another MR merges), instead of
  // requiring a manual rebase.
  rebaseWhen: 'conflicted',
  assignees: [
    '@davinkevin',
  ],
  ignorePaths: [
    // frontend-angularjs is legacy: only build.gradle.kts and docker/Dockerfile are
    // tracked by Renovate, its JavaScript dependencies are managed manually.
    'frontend-angularjs/package.json',
  ],
  kubernetes: {
    fileMatch: [
      'distribution/kubernetes/.+\\.yaml$',
    ],
  },
  // The base image downloads ffmpeg from BtbN/FFmpeg-Builds, whose rolling
  // `latest` release only ships a subset of FFmpeg release lines (currently
  // n7.1 and n8.1). Tracking FFmpeg/FFmpeg git tags proposed versions BtbN
  // never builds (e.g. n7.2), producing MRs whose image build 404s on download.
  // This custom datasource derives the available versions from the actual BtbN
  // asset names, so Renovate only ever proposes buildable versions.
  customDatasources: {
    'btbn-ffmpeg': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/tags/latest',
      format: 'json',
      transformTemplates: [
        '{ "releases": $distinct($map(assets[$contains(name, "ffmpeg-n") and $contains(name, "linux64")].name, function($n) { $substringBefore($substringAfter($n, "ffmpeg-n"), "-latest") })).{ "version": $ } }',
      ],
    },
  },
  packageRules: [
    {
      matchPackageNames: [
        'software.amazon.awssdk:bom',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      versioning: 'regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z$',
      automerge: true,
      matchPackageNames: [
        '/^minio/',
      ],
    },
    {
      groupName: 'all-flyway',
      groupSlug: 'all-flyway',
      matchPackageNames: [
        '/.*flyway.*/',
      ],
    },
    {
      groupName: 'all-kotlin',
      groupSlug: 'all-kotlin',
      matchPackageNames: [
        '/^org.jetbrains.kotlin.*/',
      ],
    },
    {
      // Keep the Angular ecosystem in lockstep: framework, CLI, build, ESLint
      // integration and the Analog test tooling all move together.
      groupName: 'all-angular',
      groupSlug: 'all-angular',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        '/^@angular\\//',
        '/^@angular-eslint\\//',
        'angular-eslint',
        '/^@analogjs\\//',
      ],
    },
    {
      // TypeScript and zone.js are version-locked by Angular's peer dependency
      // ranges. Renovate has no peer-dependency solver, so keep it inside the
      // existing tilde ranges (patch-level only). Crossing to a new minor happens
      // manually via `ng update` when moving Angular major.
      rangeStrategy: 'in-range-only',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        'typescript',
        'zone.js',
      ],
    },
  ],
}
