{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
  ],
  rebaseWhen: 'conflicted',
  configMigration: true,
  assignees: [
    '@davinkevin',
  ],
  ignorePaths: [
    'frontend-angularjs/package.json',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/distribution/kubernetes/.+\\.yaml$/',
    ],
  },
  customDatasources: {
    'btbn-ffmpeg': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/tags/latest',
      format: 'json',
      transformTemplates: [
        '{ "releases": $distinct($map(assets[$contains(name, "ffmpeg-n") and $contains(name, "linux64")].name, function($n) { $substringBefore($substringAfter($n, "ffmpeg-n"), "-latest") })).{ "version": $ } }',
      ],
    },
  },
  packageRules: [
    {
      // Debian publishes both a bare numeric tag (`13`) and codename/alias
      // snapshots (`stable-YYYYMMDD`, `trixie-YYYYMMDD`). Default docker
      // versioning ranks the bare `13` above the dated tags and proposes a
      // scheme jump that drops date pinning. Constrain candidates to the
      // `<alias>-YYYYMMDD` scheme so Renovate only bumps the date; `stable-*`
      // then follows the current stable release across codename transitions
      // (trixie -> forky -> ...) automatically.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'debian',
      ],
      versioning: 'regex:^(?<compatibility>\\w+)-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$',
    },
    {
      matchPackageNames: [
        'software.amazon.awssdk:bom',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'pgsty/silo',
      ],
      versioning: 'regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z-(?<compatibility>distroless)$',
      automerge: true,
    },
    {
      groupName: 'all-flyway',
      groupSlug: 'all-flyway',
      matchPackageNames: [
        '/.*flyway.*/',
      ],
    },
    {
      groupName: 'all-kotlin',
      groupSlug: 'all-kotlin',
      matchPackageNames: [
        '/^org.jetbrains.kotlin.*/',
      ],
    },
    {
      groupName: 'all-angular',
      groupSlug: 'all-angular',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        '/^@angular\\//',
        '/^@angular-eslint\\//',
        'angular-eslint',
        '/^@analogjs\\//',
      ],
    },
    {
      rangeStrategy: 'in-range-only',
      matchFileNames: [
        'frontend-angular/package.json',
      ],
      matchPackageNames: [
        'typescript',
        'zone.js',
      ],
    },
  ],
}
